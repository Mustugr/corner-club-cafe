# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.

# ─── MongoDB Atlas connection string ───────────────────────────────────────
# Get it from Atlas: Connect → Drivers → Node.js, then:
#   1. Replace <db_password> with the password you set for your DB user
#   2. Add the database name (`corner-cafe`) right before the `?`
# Format:
#   mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB>?retryWrites=true&w=majority&appName=<APPNAME>
MONGODB_URI=mongodb+srv://cafe-admin:REPLACE_ME@cluster0.xxxxx.mongodb.net/corner-cafe?retryWrites=true&w=majority&appName=Cluster0

# ─── Local Express server ──────────────────────────────────────────────────
# Port the API listens on during `npm run server` / `npm run dev:all`.
# Vite proxies /api to this port (see vite.config.js).
PORT=5174

# ─── Environment ───────────────────────────────────────────────────────────
NODE_ENV=development
