# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.

# ─── MongoDB Atlas connection string ───────────────────────────────────────
# From Atlas: Connect → Drivers → Node.js. Then in the string Atlas gives you:
#   1. Replace <db_password> with your real DB user password
#   2. Insert the database name (corner-cafe) right before the `?`
#
# Final shape (do NOT commit a real URI):
#   mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_HOST.mongodb.net/corner-cafe?retryWrites=true&w=majority&appName=YOUR_APP
MONGODB_URI=

# ─── Local Express server ──────────────────────────────────────────────────
# Port the API listens on during `npm run server` / `npm run dev:all`.
# Vite proxies /api to this port (see vite.config.js).
PORT=5174

# ─── Environment ───────────────────────────────────────────────────────────
NODE_ENV=development
